        android:name="com.example.chatbox.main.fragments.home.Chats.ChatMessages.ChatFragment"
        android:label="ChatFragment" >

    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.chatbox.main.fragments.settings.SettingsFragment"
        android:label="SettingsFragment" >

    </fragment>
    <fragment
