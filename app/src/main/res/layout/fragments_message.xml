<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/DeepGreen"
    >

    <FrameLayout
        android:id="@+id/searchChats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        app:layout_constraintTop_toTopOf="@+id/tv_fragment_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="@+id/tv_fragment_title">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bg_deep_green"
            android:contentDescription="@string/search_background"/>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/ic_fragments_search"
            android:contentDescription="@string/search_icon"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_fragment_title"
        style="@style/FragmentsNamesStyle"
        android:text="@string/home"
        app:layout_constraintBottom_toTopOf="@+id/rv_status_list"
        app:layout_constraintEnd_toStartOf="@+id/img_profile_picture"
        app:layout_constraintStart_toEndOf="@+id/searchChats"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img_profile_picture"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="24dp"
        android:scaleType="centerCrop"
        android:src="@drawable/img_profile_user"
        app:layout_constraintBottom_toBottomOf="@+id/tv_fragment_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_fragment_title"
        app:shapeAppearanceOverlay="@style/circleImageView"
        android:contentDescription="@string/profile_picture" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_status_list"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="140dp"
        android:layout_marginStart="20dp"
        android:background="@color/DeepGreen"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_fragment_default"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_status_list"
        tools:itemCount="5"
        tools:listitem="@layout/item_message" />

</androidx.constraintlayout.widget.ConstraintLayout>
