<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp">

    <TextView
        android:id="@+id/itemMessageRequest"
        style="@style/itemMessage"
        android:background="@drawable/shape_message_request"
        android:text="@string/receive_message"
        android:textColor="@color/DeepGreen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemMessageRequestTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="@string/_9_25_am"
        android:textColor="@color/secondaryGray"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="@id/itemMessageRequest"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
