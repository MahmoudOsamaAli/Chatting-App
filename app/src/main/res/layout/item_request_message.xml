<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/itemMessageRequest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@drawable/shape_message_request"
        android:text="@string/receive_message"
        android:textColor="@color/DeepGreen"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp"/>
    <TextView
        android:id="@+id/itemMessageRequestTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9:25 AM"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/itemMessageRequest"
        app:layout_constraintTop_toBottomOf="@id/itemMessageRequest"
        android:layout_marginEnd="8dp"
        android:textColor="#797C7B"/>



</androidx.constraintlayout.widget.ConstraintLayout>