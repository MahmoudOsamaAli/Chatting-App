<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_light_chat"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chat_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chat_user_section"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/chat_ic_back_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_back_arrow_deep_green"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/chat_fl_user_profile_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/chat_ic_back_arrow"
            app:layout_constraintStart_toEndOf="@id/chat_ic_back_arrow"
            app:layout_constraintTop_toTopOf="@+id/chat_ic_back_arrow">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chat_user_profile_image"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:scaleType="centerCrop"
                android:src="@drawable/img_profile_empty"
                app:shapeAppearanceOverlay="@style/circleImageView" />
            <ImageView
                android:id="@+id/chat_iv_user_online_status"
                android:layout_width="8dp"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="2dp"
                android:visibility="invisible"
                android:src="@drawable/shape_active_user" />
        </FrameLayout>

        <View
            android:id="@+id/chat_user_Info"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/chat_fl_user_profile_image"
            app:layout_constraintEnd_toStartOf="@id/chat_ic_audio_call"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/chat_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            tools:text="@string/user_name"
            android:textColor="@color/DeepGreen"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/chat_fl_user_profile_image"
            app:layout_constraintTop_toTopOf="@id/chat_fl_user_profile_image" />

        <TextView
            android:id="@+id/chat_user_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="@string/user_state"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/chat_user_name"
            app:layout_constraintTop_toBottomOf="@+id/chat_user_name" />

        <ImageView
            android:id="@+id/chat_ic_audio_call"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_messages_audio_call"
            app:layout_constraintBottom_toBottomOf="@+id/chat_fl_user_profile_image"
            app:layout_constraintEnd_toStartOf="@id/chat_ic_call_video"
            app:layout_constraintTop_toTopOf="@+id/chat_fl_user_profile_image" />

        <ImageView
            android:id="@+id/chat_ic_call_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_messages_call_video"
            app:layout_constraintBottom_toBottomOf="@+id/chat_ic_audio_call"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/chat_ic_audio_call" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@+id/messagesSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chat_toolbar"
        app:layout_constraintVertical_bias="0.0"
        tools:itemCount="20"
        tools:listitem="@layout/item_request_message" />
    <TextView
        android:id="@+id/chat_messages_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        android:background="@drawable/bg_tv_chat_date"
        android:text="@string/today"
        android:textColor="@color/DeepGreen"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/chat_recycler_view" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/messagesSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/chat_et_new_message"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginEnd="60dp"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_et_new_message"
            android:drawableStart="@drawable/ic_messages_path"
            android:drawableEnd="@drawable/ic_messages_copy"
            android:drawablePadding="24dp"
            android:fontFamily="@font/circular_std"
            android:hint="@string/write_your_message"
            android:paddingStart="36dp"
            android:paddingEnd="8dp"
            android:textColor="@color/textColorPrimary"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/chat_ic_gallery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_messages_gallery"
            app:layout_constraintBottom_toBottomOf="@id/chat_et_new_message"
            app:layout_constraintStart_toStartOf="@+id/chat_et_new_message"
            app:layout_constraintTop_toTopOf="@+id/chat_et_new_message" />
        <FrameLayout
            android:id="@+id/chat_fl_mic_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@id/chat_ic_gallery"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chat_et_new_message"
            app:layout_constraintTop_toTopOf="@id/chat_ic_gallery" >
            <ImageView
                android:layout_width="24dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_tv_chat_date"/>
            <ImageView
                android:id="@+id/chat_ic_mic_record"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_chat_mic_green"/>

        </FrameLayout>


        <ImageView
            android:id="@+id/chat_ic_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:visibility="gone"
            android:src="@drawable/ic_messages_send"
            app:layout_constraintBottom_toBottomOf="@id/chat_et_new_message"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/chat_et_new_message"
            app:layout_constraintTop_toTopOf="@id/chat_et_new_message" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
