<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:id="@+id/itemMessageSend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="send Message"
        android:textColor="@color/White"
        android:background="@drawable/shape_message_send"
        android:padding="8dp"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="12dp"
        />
    <TextView
        android:id="@+id/itemMessageSendTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9:25 AM"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/itemMessageSend"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/itemMessageSend"
        android:layout_marginStart="8dp"
        android:textColor="#797C7B"/>


</androidx.constraintlayout.widget.ConstraintLayout>