<resources>

    <!-- Buttons -->
    <style name="AuthButtonStyle">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:fontFamily">@font/caros</item>
        <item name="android:textColor">@drawable/selector_button_auth</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
        <item name="android:background">@drawable/bg_button_auth</item>
    </style>

    <!-- EditText -->
    <style name="AuthTextFieldStyle" parent="Widget.AppCompat.EditText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:fontFamily">@font/caros</item>
        <item name="android:layout_weight">400</item>
        <item name="lineHeight">20dp</item>
        <item name="android:textColor">@color/DeepGreen</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:layout_marginEnd">24dp</item>
    </style>

    <!-- TextViews -->
    <style name="AuthTitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:fontFamily">@font/caros</item>
        <item name="android:layout_weight">600</item>
        <item name="lineHeight">18dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/DeepGreen</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">72dp</item>
    </style>

    <style name="AuthSubTitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">24dp</item>
        <item name="lineHeight">20dp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:fontFamily">@font/circular_std</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/secondaryGray</item>
    </style>

    <style name="AuthLabelStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:fontFamily">@font/circular_std</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:layout_weight">500</item>
        <item name="lineHeight">14dp</item>
        <item name="android:textColor">@color/primaryGreen</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_marginStart">4dp</item>
    </style>

    <style name="FragmentsNamesStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/White</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">@font/caros</item>
    </style>

    <style name="SettingsTitleStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="fontFamily">@font/caros</item>
        <item name="fontWeight">500</item>
        <item name="lineHeight">16dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/DeepGreen</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsDescriptionStyle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="fontFamily">@font/circular_std</item>
        <item name="fontWeight">450</item>
        <item name="lineHeight">12dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/secondaryGray</item>
    </style>

    <!-- Icons -->
    <style name="AuthIconStyle">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_margin">24dp</item>

    </style>
    <style name="SettingsIcon" parent="circleImageView">
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_marginStart">28dp</item>
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <style name="BgFragmentsStyle">
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_fragment_default</item>
        <item name="android:layout_marginTop">144dp</item>
        
    </style>


</resources>
